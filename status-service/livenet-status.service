[Unit]
Description=LiveNet status pages
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/livenet-status/statusd.py
Environment=STATUSD_CONFIG=/etc/livenet-status/config.json
EnvironmentFile=/etc/livenet-status/env
DynamicUser=yes
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
